{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Analytics Dev",
  "version": "0.1.1",
  "identifier": "com.donpely.web-analytics-dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Web Analytics Dev",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Cookieless web analytics and website uptime monitoring.",
    "longDescription": "Web Analytics Dev by Don PELY — lightweight, cookieless web analytics with a fast dashboard plus website uptime monitoring (ping + HTTP checks) with desktop down/recovery alerts.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
